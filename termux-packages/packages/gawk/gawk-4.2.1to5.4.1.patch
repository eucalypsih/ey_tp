+	nan_str =  sprintf("%Pf", nan)
+	nnan_str = sprintf("%Pf", -nan)
+	if (nan_str == "nan")
+		nan_str = "+" nan_str
+	if (nnan_str == "nan")
+		nnan_str = "+" nnan_str
 	inf = -log(0)
-	inf_str = sprintf("%f",inf)
+	inf_str = sprintf("%Pf", inf)
+	if (inf_str == "inf")
