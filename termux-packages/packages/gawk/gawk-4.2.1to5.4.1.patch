+	print ""
+
+	# Numerator < denominator. Integer and fractional code paths.
+	printf " 2 %  7 = % g\n",  2 %  7
+	printf " 2 % -7 = % g\n",  2 % -7
+	printf "-2 %  7 = % g\n", -2 %  7
