+	printf "-2 % -7.0 = % g\n", -2 % -7.0
+	print ""
+
+	# These arguments require the fractional code path.
+	printf " 8.911 %  4.2 = % g\n",  8.911 %  4.2
+	printf " 8.911 % -4.2 = % g\n",  8.911 % -4.2
+	printf "-8.911 %  4.2 = % g\n", -8.911 %  4.2
+	printf "-8.911 % -4.2 = % g\n", -8.911 % -4.2
 }
